{
    "name": "ricardo07g/laravel-guarda-bot",
    "description": "Protecao em camadas contra bots, browsers automatizados e agentes de IA para aplicacoes Laravel.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "bot",
        "anti-bot",
        "turnstile",
        "honeypot",
        "playwright",
        "seguranca"
    ],
    "require": {
        "php": "^8.3",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/view": "^13.0",
        "jaybizzle/crawler-detect": "^1.4",
        "laravel/prompts": "^0.3"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Ricardo07g\\GuardaBot\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ricardo07g\\GuardaBot\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ricardo07g\\GuardaBot\\GuardaBotServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
