APP_NAME="Meu Negócio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=meu_negocio
DB_USERNAME=meu_negocio
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Agendador por HTTP (POST /cron/executar), usado em producao no lugar de um
# processo schedule:work — quem dispara e um Cron Trigger do Cloudflare Workers.
# Vazio = endpoint responde 404 (fail-closed). Em dev o docker-compose ja sobe o
# servico `scheduler`, entao so preencha para testar o endpoint na mao.
CRON_TOKEN=
# CRON_JANELA_HORAS=24

# Cloudflare Turnstile (anti-bot em login/registro/recuperacao de senha).
# Nao exige o dominio no Cloudflare. Chaves VAZIAS = recurso desligado: o widget
# nao renderiza e a validacao passa direto — dev, CI e testes rodam sem chave.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email. Em dev o padrao e `log` (a mensagem cai em storage/logs/laravel.log) e
# as chaves SMTP abaixo servem para apontar um Mailtrap sandbox quando voce quiser
# ver o email renderizado numa caixa de verdade.
#
# Em PRODUCAO o transporte e a API HTTPS do Resend (`MAIL_MAILER=resend` +
# RESEND_API_KEY), nunca SMTP: o Railway so libera SMTP no plano Pro e, nos demais,
# DESCARTA a conexao em silencio — o request fica pendurado ate o timeout, sem erro.
# Como a fila e `sync`, esse envio acontece dentro do POST /esqueci-senha. Ver ADR-0020.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Chave da API do Resend (config/services.php). Vazia em dev e no CI; em producao
# vive so nas variaveis do Railway.
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

R2_BUCKET=""
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PUBLIC_BASE_URL=""

# Imagens: toda imagem convertivel e reencodada em WebP na gravacao.
# Exige GD com --with-webp (ja embutido nos Dockerfiles do projeto).
ARQUIVOS_CONVERTER_WEBP=true
ARQUIVOS_WEBP_QUALIDADE=82
ARQUIVOS_LARGURA_MAXIMA=1600

# ---------------------------------------------------------------------------
# Analise por IA (modulo Ia)
#
# Desligada sem credencial: a tela degrada com aviso e nada e chamado — dev, CI e
# testes rodam sem chave e sem tocar a rede.
#
# Padrao = Cloudflare Workers AI, reaproveitando a conta que ja serve R2/Turnstile/cron:
# IA_CF_ACCOUNT_ID cai no R2_ACCOUNT_ID quando nao definido.
#
# Token: o caminho mais curto e o proprio painel do Workers AI
# (https://dash.cloudflare.com/?to=/:account/ai/workers-ai) -> "Use REST API" ->
# "Create a Workers AI API Token", que ja vem com as permissoes certas. Se for criar um
# token customizado, ele precisa de "Workers AI - Read" **e** "Workers AI - Edit": rodar
# inferencia conta como escrita no modelo de permissoes da Cloudflare, e so com Read a
# chamada volta 403.
# ---------------------------------------------------------------------------
IA_DRIVER=workers_ai
# IA_CF_ACCOUNT_ID=
# IA_CF_TOKEN=
# Modelo. O padrao (70B) custa ~US$ 0,001 (~88 neuronios) por analise da carteira. Com a
# franquia de 10 analises/dia por unidade, cabem ~11 unidades no limite dentro da cota
# gratis de 10.000 neuronios/dia da Cloudflare. Escolhido por
# aderencia ao schema e portugues, nao por preco: a Cloudflare devolve ERRO quando o modelo
# nao cumpre o JSON pedido, e modelo pequeno falha nisso com mais frequencia.
# Alternativa ~6x mais barata, se precisar de mais volume:
#   IA_CF_MODELO="@cf/meta/llama-3.1-8b-instruct-fp8-fast"
# (a doc da Cloudflare diverge no nome desse: a pagina de JSON mode o chama de
#  "llama-3.1-8b-instruct-fast". Confirme com `php artisan ia:testar` — nome errado da 404.)
# IA_CF_MODELO="@cf/meta/llama-3.3-70b-instruct-fp8-fast"

# Escape hatch: IA_DRIVER=gemini (responseSchema imposto pelo servidor).
# IA_GEMINI_CHAVE=
# IA_GEMINI_MODELO=gemini-2.5-flash-lite

# Teto de tokens da resposta. Sem isso a Cloudflare corta o JSON no meio e o driver recusa
# por "formato invalido" — sintoma que nao aponta para o tamanho.
# IA_MAX_TOKENS=1500
# Temperatura baixa: isto e um relatorio, nao texto criativo — a mesma carteira deve
# produzir a mesma leitura, senao o usuario desconfia do numero.
# IA_TEMPERATURA=0.2
# IA_TIMEOUT=30
# IA_CACHE_DIAS=30
# IA_FUSO=America/Sao_Paulo
